PORT=5000
NODE_ENV=development

# LOCAL (MongoDB Compass):  mongodb://127.0.0.1:27017/muldhon
# VERCEL  (MongoDB Atlas):  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/muldhon
# Vercel cannot reach localhost — deployment REQUIRES an Atlas URI.
MONGO_URI="mongodb://127.0.0.1:27017/muldhon"

JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="7d"

# Comma separated, NO trailing slash (a trailing slash breaks CORS).
CLIENT_URL="http://localhost:5173,https://your-frontend.vercel.app"
